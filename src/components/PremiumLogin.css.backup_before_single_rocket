/* SMOOTH POSTER ORBIT OVERRIDE */
.premium-poster-wall {
  position: absolute;
  inset: 0;
  z-index: -3;
  opacity: 0.27;
  pointer-events: none;
  transform-origin: center center;
  transform: translateZ(0);
  will-change: transform;
  animation: premiumPosterOrbit 32s linear infinite;
  filter: none;
  overflow: visible;
}

.premium-poster {
  position: absolute;
  left: 50% !important;
  top: 50% !important;
  right: auto !important;
  bottom: auto !important;
  width: clamp(100px, 10vw, 155px) !important;
  height: clamp(140px, 14vw, 220px) !important;
  margin: 0;
  transform-origin: center center;
  will-change: transform;
  backface-visibility: hidden;
  animation: premiumPosterOrbitCard 32s linear infinite;
}

@keyframes premiumPosterOrbit {
  from { transform: translateZ(0) rotate(0deg); }
  to { transform: translateZ(0) rotate(360deg); }
}

@keyframes premiumPosterOrbitCard {
  from {
    transform:
      rotate(var(--poster-angle))
      translateX(clamp(250px, 42vw, 600px))
      rotate(calc(var(--poster-angle) * -1));
  }
  to {
    transform:
      rotate(var(--poster-angle))
      translateX(clamp(250px, 42vw, 600px))
      rotate(calc(var(--poster-angle) * -1 - 360deg));
  }
}

@media (max-width: 700px) {
  .premium-poster {
    width: clamp(72px, 19vw, 105px) !important;
    height: clamp(100px, 27vw, 145px) !important;
  }

  @keyframes premiumPosterOrbitCardMobile {
    from {
      transform:
        rotate(var(--poster-angle))
        translateX(clamp(190px, 52vw, 260px))
        rotate(calc(var(--poster-angle) * -1));
    }
    to {
      transform:
        rotate(var(--poster-angle))
        translateX(clamp(190px, 52vw, 260px))
        rotate(calc(var(--poster-angle) * -1 - 360deg));
    }
  }

  .premium-poster {
    animation-name: premiumPosterOrbitCardMobile;
  }
}



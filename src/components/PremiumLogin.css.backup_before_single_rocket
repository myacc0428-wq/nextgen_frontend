:root {
  --premium-bg: #02060d;
  --premium-purple: #9d46ff;
  --premium-violet: #6e55ff;
  --premium-cyan: #19dfff;
  --premium-blue: #3d7dff;
  --premium-text: #f7f9ff;
  --premium-muted: #a8b1ca;
}

.premium-login-scene {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
  isolation: isolate;
  display: grid;
  place-items: center;
  color: var(--premium-text);
  background:
    radial-gradient(
      circle at 50% 16%,
      rgba(55, 80, 160, 0.28),
      transparent 25%
    ),
    radial-gradient(
      circle at 15% 84%,
      rgba(140, 62, 255, 0.22),
      transparent 26%
    ),
    radial-gradient(
      circle at 86% 82%,
      rgba(0, 211, 255, 0.18),
      transparent 28%
    ),
    linear-gradient(
      180deg,
      #03060d 0%,
      #06101c 52%,
      #02050b 100%
    );
}

.premium-login-scene::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -4;
  background:
    linear-gradient(
      180deg,
      rgba(2, 6, 13, 0.08),
      rgba(2, 6, 13, 0.48)
    ),
    radial-gradient(
      circle at 50% 40%,
      transparent 0,
      rgba(0, 0, 0, 0.13) 46%,
      rgba(0, 0, 0, 0.58) 100%
    );
}

.premium-sky-glow {
  position: absolute;
  inset: -12%;
  z-index: -5;
  background:
    radial-gradient(
      circle at 33% 20%,
      rgba(155, 67, 255, 0.18),
      transparent 18%
    ),
    radial-gradient(
      circle at 66% 16%,
      rgba(0, 221, 255, 0.16),
      transparent 18%
    ),
    radial-gradient(
      circle at 52% 42%,
      rgba(82, 89, 255, 0.12),
      transparent 18%
    );
  filter: blur(20px);
  animation: premiumSky 12s ease-in-out infinite alternate;
}

@keyframes premiumSky {
  to {
    transform: scale(1.08) translateY(10px);
  }
}

.premium-poster-wall {
  position: absolute;
  transform-origin: center;
  will-change: transform;
  animation: premiumPosterDrift 20s ease-in-out infinite alternate;
  inset: 0;
  z-index: -3;
  opacity: 0.27;
  filter: blur(0.8px);
  pointer-events: none;
}

.premium-poster {
  position: absolute;
  border: 1px solid rgba(173, 181, 255, 0.18);
  border-radius: 16px;
  overflow: hidden;
  box-shadow:
    0 18px 40px rgba(0, 0, 0, 0.35),
    inset 0 0 30px rgba(255, 255, 255, 0.04);
}

.premium-poster::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      circle at 28% 22%,
      rgba(255, 255, 255, 0.28),
      transparent 20%
    ),
    radial-gradient(
      circle at 73% 68%,
      rgba(0, 220, 255, 0.25),
      transparent 22%
    ),
    linear-gradient(
      155deg,
      #202843,
      #1a1542 45%,
      #153b51
    );
}

.premium-poster-2::before {
  background:
    linear-gradient(
      155deg,
      #22132e,
      #683c75 50%,
      #163d52
    );
}

.premium-poster-3::before {
  background:
    linear-gradient(
      155deg,
      #152a43,
      #0e5571 58%,
      #5f194f
    );
}

.premium-poster-4::before {
  background:
    linear-gradient(
      155deg,
      #3b2031,
      #7b1f4b 50%,
      #1a2b54
    );
}

.premium-poster-5::before {
  background:
    linear-gradient(
      155deg,
      #111c33,
      #3039a2 55%,
      #4f1766
    );
}

.premium-poster-6::before {
  background:
    linear-gradient(
      155deg,
      #1b2438,
      #6e2150 54%,
      #0e5d71
    );
}

@keyframes premiumPosterDrift {
  from {
    transform: scale(1) translate3d(0, 0, 0);
  }
  to {
    transform: scale(1.045) translate3d(-18px, 8px, 0);
  }
}

.premium-poster span {
  position: absolute;
  inset: auto 10px 10px;
  z-index: 2;
  font-size: 10px;
  letter-spacing: 1.3px;
  text-transform: uppercase;
  color: #fff;
  font-weight: 800;
  text-shadow: 0 2px 12px #000;
}

.premium-ribbon {
  will-change: transform;

  position: absolute;
  z-index: -2;
  left: -8%;
  width: 116%;
  height: 190px;
  border-radius: 50%;
  mix-blend-mode: screen;
}

.premium-ribbon-one {
  bottom: 11%;
  transform: rotate(-6deg);
  background:
    linear-gradient(
      90deg,
      transparent 0%,
      rgba(155, 67, 255, 0.52) 17%,
      rgba(0, 220, 255, 0.60) 49%,
      rgba(125, 65, 255, 0.42) 73%,
      transparent 100%
    );
  box-shadow:
    0 0 34px rgba(97, 103, 255, 0.35),
    0 0 85px rgba(100, 65, 255, 0.22);
  animation: premiumRibbonA 7s ease-in-out infinite;
}

.premium-ribbon-two {
  bottom: -3%;
  transform: rotate(7deg);
  background:
    linear-gradient(
      90deg,
      transparent 0%,
      rgba(46, 83, 255, 0.36) 25%,
      rgba(0, 234, 255, 0.58) 63%,
      rgba(170, 54, 255, 0.36) 83%,
      transparent 100%
    );
  box-shadow: 0 0 32px rgba(0, 206, 255, 0.35);
  animation: premiumRibbonB 9s ease-in-out infinite;
}

@keyframes premiumRibbonA {
  50% {
    transform: rotate(-4deg) translateY(-13px) scaleX(1.03);
  }
}

@keyframes premiumRibbonB {
  50% {
    transform: rotate(10deg) translateY(9px) scaleX(1.04);
  }
}

.premium-floor {
  position: absolute;
  left: -10%;
  right: -10%;
  bottom: -12%;
  height: 40%;
  z-index: -1;
  background:
    radial-gradient(
      ellipse at center top,
      rgba(31, 49, 100, 0.28),
      transparent 55%
    ),
    linear-gradient(
      180deg,
      transparent 0%,
      rgba(3, 8, 17, 0.65) 55%,
      rgba(2, 4, 9, 0.97) 100%
    );
  transform: perspective(550px) rotateX(56deg);
  transform-origin: bottom center;
}

.premium-floor::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 34%;
  height: 1px;
  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(126, 162, 255, 0.16),
      transparent
    );
  box-shadow:
    0 34px 0 rgba(126, 162, 255, 0.08),
    0 68px 0 rgba(126, 162, 255, 0.06),
    0 102px 0 rgba(126, 162, 255, 0.04);
}

.premium-particles {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
}

.premium-particle {
  will-change: transform, opacity;

  position: absolute;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #dbe4ff;
  opacity: 0.45;
  box-shadow: 0 0 12px rgba(112, 196, 255, 0.8);
  transform: scale(var(--particle-scale));
  animation:
    premiumRise
    var(--particle-duration)
    linear
    infinite;
  animation-delay: var(--particle-delay);
}

@keyframes premiumRise {
  from {
    transform:
      translateY(20px)
      scale(var(--particle-scale));
    opacity: 0;
  }

  15% {
    opacity: 0.55;
  }

  80% {
    opacity: 0.32;
  }

  to {
    transform:
      translateY(-60px)
      scale(var(--particle-scale));
    opacity: 0;
  }
}

.premium-enter-chip {
  position: absolute;
  right: 24px;
  top: 24px;
  padding: 8px 11px;
  border-radius: 999px;
  background: rgba(8, 16, 31, 0.42);
  border: 1px solid rgba(132, 151, 227, 0.13);
  color: #7e8ba8;
  font-size: 9px;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.premium-center-stage {
  position: relative;
  z-index: 5;
  width: min(1120px, 94vw);
  min-height: 100vh;
  padding: 40px 0;
  display: grid;
  place-items: center;
  align-content: center;
  justify-items: center;
  gap: 18px;
  text-align: center;
}

.premium-brand-zone {
  transition:
    transform 0.6s ease,
    filter 0.6s ease;
}

.premium-brand-zone:hover {
  transform: translateY(-3px);
  filter: brightness(1.04);
}

.premium-logo-img {
  will-change: transform, filter;

  width: min(380px, 64vw);
  max-width: 380px;
  display: block;
  margin: 0 auto;
  mix-blend-mode: screen;
  filter:
    drop-shadow(
      0 0 12px rgba(117, 87, 255, 0.38)
    )
    drop-shadow(
      0 0 34px rgba(0, 220, 255, 0.20)
    );
  animation: premiumLogoGlow 4.6s ease-in-out infinite;
}

@keyframes premiumLogoGlow {
  0%,
  100% {
    filter:
      drop-shadow(
        0 0 10px rgba(120, 74, 255, 0.30)
      )
      drop-shadow(
        0 0 28px rgba(0, 220, 255, 0.16)
      );
  }

  50% {
    filter:
      drop-shadow(
        0 0 22px rgba(155, 66, 255, 0.54)
      )
      drop-shadow(
        0 0 50px rgba(0, 220, 255, 0.28)
      );
  }
}

.premium-slogan {
  margin-top: 3px;
  font-size: 11px;
  letter-spacing: 7px;
  color: #b9c2d9;
  text-transform: uppercase;
  text-shadow: 0 0 18px rgba(99, 131, 255, 0.22);
}

.premium-login-card {
  will-change: transform;

  width: min(460px, 92vw);
  padding: 28px 30px 26px;
  border-radius: 28px;
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(
      145deg,
      rgba(25, 39, 76, 0.42),
      rgba(6, 13, 28, 0.53)
    );
  border: 1px solid rgba(149, 139, 255, 0.28);
  box-shadow:
    0 30px 90px rgba(0, 0, 0, 0.50),
    inset 0 1px 0 rgba(255, 255, 255, 0.08),
    0 0 42px rgba(91, 75, 255, 0.10);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
}

.premium-login-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1px;
  background:
    linear-gradient(
      110deg,
      rgba(154, 60, 255, 0.65),
      rgba(0, 218, 255, 0.34),
      rgba(76, 93, 255, 0.15),
      rgba(154, 60, 255, 0.52)
    );
  -webkit-mask:
    linear-gradient(#000 0 0) content-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  animation: premiumBorderShift 6s linear infinite;
  pointer-events: none;
}

@keyframes premiumBorderShift {
  to {
    filter: hue-rotate(55deg);
  }
}

.premium-card-inner {
  position: relative;
  z-index: 2;
}

.premium-card-title {
  margin: 0;
  font-size: 27px;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: #f7f9ff;
}

.premium-card-sub {
  margin: 7px 0 22px;
  color: var(--premium-muted);
  font-size: 12px;
}

.premium-field {
  margin: 0 0 12px;
  text-align: left;
}

.premium-field label {
  display: block;
  margin: 0 0 7px;
  color: #9aa6c3;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.premium-field input {
  width: 100%;
  height: 48px;
  border: 1px solid rgba(143, 159, 213, 0.19);
  border-radius: 14px;
  outline: 0;
  padding: 0 14px;
  color: #fff;
  background: rgba(255, 255, 255, 0.045);
  font: inherit;
  font-size: 13px;
  transition: 0.25s;
}

.premium-field input::placeholder {
  color: #737e99;
}

.premium-field input:focus {
  border-color: rgba(119, 122, 255, 0.72);
  box-shadow:
    0 0 0 4px rgba(111, 78, 255, 0.10),
    0 0 24px rgba(111, 78, 255, 0.10);
}

.premium-login-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin: 4px 0 18px;
  color: #77839f;
  font-size: 10px;
}

.premium-remember {
  display: flex;
  align-items: center;
  gap: 8px;
}

.premium-remember input {
  accent-color: #8f42ff;
}

.premium-text-button {
  width: auto;
  height: auto;
  padding: 0;
  border: 0;
  border-radius: 0;
  color: #aa95ff;
  background: transparent;
  box-shadow: none;
  font: inherit;
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
  animation: none;
}

.premium-text-button:hover {
  transform: none;
  filter: none;
  box-shadow: none;
  color: #c3b4ff;
}

.premium-login-error {
  margin-bottom: 13px;
  padding: 11px 12px;
  border-radius: 12px;
  border: 1px solid rgba(255, 91, 118, 0.24);
  color: #ffb8c4;
  background: rgba(255, 71, 101, 0.07);
  text-align: left;
  font-size: 11px;
}

.premium-signin-button {
  width: 100%;
  height: 51px;
  border: 0;
  border-radius: 15px;
  color: #fff;
  background:
    linear-gradient(
      90deg,
      var(--premium-purple),
      var(--premium-blue),
      var(--premium-cyan)
    );
  background-size: 210% 100%;
  box-shadow: 0 14px 34px rgba(76, 74, 255, 0.30);
  font: inherit;
  font-weight: 900;
  cursor: pointer;
  animation: premiumButtonFlow 4.8s linear infinite;
  transition:
    transform 0.24s ease,
    box-shadow 0.24s ease,
    filter 0.24s ease;
}

.premium-signin-button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 19px 40px rgba(76, 74, 255, 0.42);
  filter: brightness(1.06);
}

.premium-signin-button:active:not(:disabled) {
  transform: translateY(0) scale(0.985);
}

.premium-signin-button:disabled {
  cursor: wait;
  opacity: 0.75;
}

@keyframes premiumButtonFlow {
  50% {
    background-position: 100% 0;
  }
}

.premium-signup {
  margin-top: 16px;
  color: #7e89a5;
  font-size: 11px;
}

.premium-create-button {
  margin-left: 4px;
  font-size: 11px;
  font-weight: 800;
}

@media (max-width: 700px) {
  .premium-poster-wall {
    opacity: 0.16;
  }

  .premium-center-stage {
    width: 100%;
    min-height: 100vh;
    padding: 30px 0;
    gap: 12px;
  }

  .premium-logo-img {
  will-change: transform, filter;

    width: min(320px, 78vw);
  }

  .premium-slogan {
    font-size: 8px;
    letter-spacing: 4px;
  }

  .premium-login-card {
  will-change: transform;

    padding: 23px 20px 21px;
    border-radius: 23px;
  }

  .premium-card-title {
    font-size: 24px;
  }

  .premium-enter-chip {
    top: 12px;
    right: 12px;
    font-size: 8px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .premium-login-scene *,
  .premium-login-scene *::before,
  .premium-login-scene *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}

.premium-login-success {
  margin-bottom: 13px;
  padding: 11px 12px;
  border-radius: 12px;
  border: 1px solid rgba(46, 224, 156, 0.24);
  color: #a9f5d5;
  background: rgba(46, 224, 156, 0.07);
  text-align: left;
  font-size: 11px;
  line-height: 1.5;
}

.premium-text-button:disabled {
  opacity: 0.55;
  cursor: wait;
}

.premium-create-backdrop {
  position: fixed;
  inset: 0;
  z-index: 6000;
  display: grid;
  place-items: center;
  padding: 18px;
  background: rgba(1, 4, 10, 0.78);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  animation: premiumCreateFade .2s ease;
}

@keyframes premiumCreateFade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.premium-create-modal {
  position: relative;
  width: min(430px, 94vw);
  padding: 28px;
  border-radius: 24px;
  border: 1px solid rgba(145, 112, 255, .30);
  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(137, 55, 255, .16),
      transparent 30%
    ),
    radial-gradient(
      circle at 88% 88%,
      rgba(15, 216, 242, .11),
      transparent 28%
    ),
    linear-gradient(
      145deg,
      rgba(12, 24, 49, .98),
      rgba(5, 12, 27, .98)
    );
  box-shadow:
    0 35px 90px rgba(0,0,0,.58),
    0 0 50px rgba(92, 71, 255, .10),
    inset 0 1px 0 rgba(255,255,255,.06);
  text-align: center;
}

.premium-create-close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 10px;
  color: #aab5cb;
  background: rgba(255,255,255,.04);
  cursor: pointer;
}

.premium-create-close:hover {
  color: #fff;
  background: rgba(255,255,255,.08);
}

.premium-create-icon {
  width: 48px;
  height: 48px;
  margin: 0 auto 12px;
  display: grid;
  place-items: center;
  border-radius: 15px;
  color: #fff;
  background:
    linear-gradient(
      135deg,
      #8638ff,
      #536cff,
      #18d4f1
    );
  box-shadow: 0 14px 30px rgba(91,75,255,.25);
  font-size: 22px;
}

.premium-create-modal h2 {
  margin: 0;
  color: #fff;
  font-size: 24px;
  line-height: 1.15;
}

.premium-create-modal > p {
  margin: 8px 0 20px;
  color: #96a4bf;
  font-size: 11px;
  line-height: 1.65;
}

.premium-create-modal .premium-field {
  margin-bottom: 12px;
}

.premium-create-submit {
  margin-top: 4px;
}

@media (max-width: 520px) {
  .premium-create-modal {
    padding: 24px 18px 20px;
    border-radius: 20px;
  }

  .premium-create-modal h2 {
    font-size: 21px;
  }
}

/* =========================================================
   ACCOUNT CREATED / ADMIN APPROVAL NOTICE
   ========================================================= */

.premium-approval-backdrop {
  position: fixed;
  inset: 0;
  z-index: 7000;
  display: grid;
  place-items: center;
  padding: 18px;
  background: rgba(1, 4, 10, 0.78);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  animation: premiumApprovalFade .2s ease;
}

@keyframes premiumApprovalFade {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

.premium-approval-notice {
  position: relative;
  width: min(440px, 94vw);
  padding: 31px 28px 26px;
  border-radius: 25px;
  border: 1px solid rgba(122, 94, 255, .34);
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(126, 61, 255, .18),
      transparent 38%
    ),
    radial-gradient(
      circle at 90% 90%,
      rgba(17, 214, 241, .10),
      transparent 28%
    ),
    linear-gradient(
      145deg,
      rgba(13, 26, 53, .98),
      rgba(5, 12, 27, .99)
    );
  box-shadow:
    0 35px 100px rgba(0, 0, 0, .58),
    0 0 55px rgba(92, 68, 255, .13),
    inset 0 1px 0 rgba(255,255,255,.07);
  text-align: center;
  color: #fff;
  animation: premiumApprovalPop .25s ease;
}

@keyframes premiumApprovalPop {
  from {
    opacity: 0;
    transform: translateY(12px) scale(.97);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.premium-approval-icon {
  width: 68px;
  height: 68px;
  margin: 0 auto 14px;
  display: grid;
  place-items: center;
  border-radius: 21px;
  color: #fff;
  background:
    linear-gradient(
      135deg,
      #7f38ff,
      #5969ff,
      #18d6ef
    );
  box-shadow:
    0 17px 38px rgba(91, 72, 255, .27),
    inset 0 1px 0 rgba(255,255,255,.18);
  font-size: 30px;
  font-weight: 900;
}

.premium-approval-eyebrow {
  color: #9b87ff;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 2.2px;
}

.premium-approval-notice h2 {
  margin: 7px 0 9px;
  color: #fff;
  font-size: clamp(22px, 4vw, 28px);
  line-height: 1.15;
  letter-spacing: -.5px;
}

.premium-approval-notice > p {
  margin: 0;
  color: #9eabc4;
  font-size: 12px;
  line-height: 1.7;
}

.premium-approval-notice > p strong {
  color: #dbe7ff;
}

.premium-approval-status {
  margin: 18px auto 13px;
  width: fit-content;
  max-width: 100%;
  min-height: 38px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid rgba(32, 231, 255, .15);
  border-radius: 999px;
  color: #b9d0e8;
  background: rgba(32, 231, 255, .05);
  font-size: 10px;

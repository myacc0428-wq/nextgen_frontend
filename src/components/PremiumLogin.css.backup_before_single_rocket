/* =========================================================
   CINEGEN LOGIN — ROCKETS + SHOOTING STARS
   Lightweight background animation layer
   ========================================================= */

.premium-space-flight-effects {
  position: absolute;
  inset: 0;
  z-index: 4;
  overflow: hidden;
  pointer-events: none;
  contain: layout paint;
}

.premium-space-rocket {
  position: absolute;
  left: -150px;
  top: var(--rocket-top);
  width: 94px;
  height: 42px;
  opacity: 0;
  transform-origin: center center;
  animation:
    premiumSpaceRocketFlight
    var(--rocket-duration)
    linear
    var(--rocket-delay)
    infinite;
  will-change: transform, opacity;
}

.premium-space-rocket-body {
  position: absolute;
  left: 17px;
  top: 8px;
  width: 62px;
  height: 25px;
  border-radius: 58% 48% 48% 58%;
  background:
    linear-gradient(
      135deg,
      #f7fbff 0%,
      #cdd8e8 44%,
      #778aa8 100%
    );
  border: 1px solid rgba(255,255,255,.45);
  box-shadow:
    0 0 12px rgba(120,190,255,.48),
    0 0 26px rgba(98,78,255,.26);
}

.premium-space-rocket-body::before {
  content: "";
  position: absolute;
  right: -7px;
  top: 2px;
  width: 17px;
  height: 20px;
  border-radius: 50%;
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.96),
      rgba(90,205,255,.88)
    );
  clip-path: polygon(0 0,100% 50%,0 100%);
}

.premium-space-rocket-body::after {
  content: "";
  position: absolute;
  left: 5px;
  bottom: -6px;
  width: 23px;
  height: 11px;
  border-radius: 0 0 7px 7px;
  background: linear-gradient(180deg,#405273,#1a2238);
  transform: skewX(-18deg);
}

.premium-space-rocket-window {
  position: absolute;
  left: 24px;
  top: 5px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid rgba(210,245,255,.95);
  background:
    radial-gradient(
      circle at 35% 30%,
      #ffffff 0 14%,
      #65dcff 24%,
      #5262ff 74%
    );
  box-shadow: 0 0 12px rgba(60,220,255,.72);
}

.premium-space-rocket-flame {
  position: absolute;
  left: 1px;
  top: 13px;
  width: 24px;
  height: 13px;
  border-radius: 70% 25% 25% 70%;
  background:
    linear-gradient(
      90deg,
      rgba(126,66,255,0),
      #7f5cff 34%,
      #23d8ff 66%,
      #ffffff 100%
    );
  filter: blur(.4px);
  box-shadow:
    0 0 10px rgba(52,185,255,.72),
    0 0 24px rgba(118,70,255,.46);
  animation: premiumSpaceFlamePulse .55s ease-in-out infinite alternate;
}

.premium-space-rocket-one {
  --rocket-top: 17%;
  --rocket-duration: 15s;
  --rocket-delay: -3s;
  --rocket-drift: -12vh;
  transform: rotate(-10deg);
}

.premium-space-rocket-two {
  --rocket-top: 39%;
  --rocket-duration: 19s;
  --rocket-delay: -9s;
  --rocket-drift: -7vh;
  transform: rotate(-7deg) scale(.82);
}

.premium-space-rocket-three {
  --rocket-top: 72%;
  --rocket-duration: 22s;
  --rocket-delay: -14s;
  --rocket-drift: -15vh;
  transform: rotate(-12deg) scale(.72);
}

@keyframes premiumSpaceRocketFlight {
  0% {
    opacity: 0;
    transform:
      translate3d(-150px, 8vh, 0)
      rotate(-10deg)
      scale(.72);
  }

  8% {
    opacity: .92;
  }

  72% {
    opacity: .92;
  }

  100% {
    opacity: 0;
    transform:
      translate3d(
        calc(100vw + 220px),
        var(--rocket-drift),
        0
      )
      rotate(-10deg)
      scale(1);
  }
}

@keyframes premiumSpaceFlamePulse {
  from {
    transform: scaleX(.72);
    opacity: .72;
  }

  to {
    transform: scaleX(1.12);
    opacity: 1;
  }
}

.premium-space-shooting-star {
  position: absolute;
  width: 118px;
  height: 2px;
  border-radius: 999px;
  opacity: 0;
  background:
    linear-gradient(
      90deg,
      rgba(255,255,255,0),
      rgba(130,190,255,.25) 28%,
      rgba(255,255,255,.96) 76%,
      rgba(120,230,255,1)
    );
  box-shadow:
    0 0 6px rgba(190,235,255,.78),
    0 0 16px rgba(77,140,255,.38);
  transform: rotate(28deg);
  animation:
    premiumSpaceShootingStar
    var(--star-duration)
    linear
    var(--star-delay)
    infinite;
  will-change: transform, opacity;
}

.premium-space-shooting-star::after {
  content: "";
  position: absolute;
  right: -3px;
  top: 50%;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  transform: translateY(-50%);
  background: #ffffff;
  box-shadow:
    0 0 7px rgba(255,255,255,.98),
    0 0 18px rgba(70,210,255,.82);
}

.premium-space-star-one {
  left: 76%;
  top: 8%;
  --star-duration: 5.5s;
  --star-delay: -1s;
}

.premium-space-star-two {
  left: 91%;
  top: 22%;
  --star-duration: 6.8s;
  --star-delay: -4.5s;
  transform: rotate(32deg) scale(.78);
}

.premium-space-star-three {
  left: 62%;
  top: 28%;
  --star-duration: 7.4s;
  --star-delay: -6.2s;
  transform: rotate(28deg) scale(.64);
}

.premium-space-star-four {
  left: 84%;
  top: 46%;
  --star-duration: 8.2s;
  --star-delay: -2.8s;
  transform: rotate(30deg) scale(.72);
}

.premium-space-star-five {
  left: 54%;
  top: 14%;
  --star-duration: 6.1s;
  --star-delay: -8s;
  transform: rotate(27deg) scale(.55);
}

@keyframes premiumSpaceShootingStar {
  0% {
    opacity: 0;
    transform:
      translate3d(12vw, -8vh, 0)
      rotate(28deg)
      scale(.35);
  }

  10% {
    opacity: .9;
  }

  30% {
    opacity: 1;
  }

  58% {
    opacity: .75;
  }

  100% {
    opacity: 0;
    transform:
      translate3d(-72vw, 68vh, 0)
      rotate(28deg)
      scale(.85);
  }
}

@media (max-width: 700px) {
  .premium-space-flight-effects {
    opacity: .72;
  }

  .premium-space-rocket {
    transform-origin: center center;
  }

  .premium-space-rocket-two {
    transform: rotate(-7deg) scale(.68);
  }

  .premium-space-rocket-three {
    transform: rotate(-12deg) scale(.58);
  }

  .premium-space-shooting-star {
    width: 88px;
    height: 1.5px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .premium-space-flight-effects,
  .premium-space-rocket,
  .premium-space-rocket-flame,
  .premium-space-shooting-star {
    animation: none !important;
  }

  .premium-space-rocket,
  .premium-space-shooting-star {
    opacity: 0 !important;
  }
}
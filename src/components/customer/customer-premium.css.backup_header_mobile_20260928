/* =========================================================
   CINEGEN CUSTOMER DASHBOARD
   ========================================================= */

.cg-shell {
  --bg: #050711;
  --panel: rgba(11, 15, 32, .82);
  --border: rgba(255,255,255,.065);
  --muted: #7e879d;
  --purple: #7438ff;
  --magenta: #a94fff;
  --blue: #4b88ff;

  min-height: 100vh;
  display: flex;
  overflow-x: hidden;
  color: #f7f7fb;
  background:
    radial-gradient(circle at 72% 5%, rgba(105,49,255,.15), transparent 25%),
    radial-gradient(circle at 92% 58%, rgba(45,177,255,.07), transparent 24%),
    linear-gradient(135deg, #040610, #090c19 52%, #071625);
}

.cg-shell button {
  font: inherit;
}

.cg-sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 50;
  width: 236px;
  padding: 24px 15px 20px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: rgba(4,7,19,.94);
  border-right: 1px solid var(--border);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
}

.cg-brand {
  height: 51px;
  margin: 0 10px 31px;
  display: flex;
  align-items: center;
}

.cg-brand img {
  display: block;
  width: 148px;
  max-height: 51px;
  object-fit: contain;
}

.cg-side-nav {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.cg-side-nav button,
.cg-sidebar-bottom button {
  border: 0;
  border-radius: 13px;
  padding: 12px 13px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: #9ea7bc;
  background: transparent;
  cursor: pointer;
  text-align: left;
  font-size: 13px;
  transition: .2s ease;
}

.cg-side-nav button:hover,
.cg-sidebar-bottom button:hover {
  color: #fff;
  background: rgba(255,255,255,.045);
  transform: translateX(2px);
}

.cg-side-nav button.active {
  color: #fff;
  background: linear-gradient(90deg, rgba(115,54,255,.94), rgba(115,54,255,.21));
  box-shadow:
    inset 3px 0 0 #a855ff,
    0 10px 28px rgba(113,55,255,.12);
}

.cg-sidebar-heading {
  margin: 31px 12px 11px;
  color: #5b657f;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.55px;
}

.cg-genres {
  display: flex;
  flex-direction: column;
  gap: 2px;
  overflow: auto;
  scrollbar-width: none;
}

.cg-genres::-webkit-scrollbar {
  display: none;
}

.cg-genres button {
  border: 0;
  border-radius: 11px;
  padding: 8px 13px;
  color: #8d97ac;
  background: transparent;
  cursor: pointer;
  text-align: left;
  font-size: 12px;
  transition: .2s ease;
}

.cg-genres button:hover {
  color: #fff;
  background: rgba(255,255,255,.035);
}

.cg-genres button.active {
  color: #d9c6ff;
  background: rgba(119,57,255,.13);
}

.cg-sidebar-bottom {
  margin-top: auto;
  padding-top: 15px;
  border-top: 1px solid rgba(255,255,255,.055);
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.cg-main {
  position: relative;
  width: calc(100% - 236px);
  margin-left: 236px;
  min-width: 0;
  padding: 18px 23px 60px;
  box-sizing: border-box;
}

.cg-header {
  min-height: 55px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.cg-desktop-links {
  display: flex;
  align-items: center;
  gap: 5px;
}

.cg-desktop-links button {
  min-height: 42px;
  padding: 0 16px;
  border: 1px solid transparent;
  border-radius: 12px;
  color: #9ea6b9;
  background: transparent;
  cursor: pointer;
  font-size: 12px;
  transition: .2s ease;
}

.cg-desktop-links button:hover {
  color: #fff;
  background: rgba(255,255,255,.035);
}

.cg-desktop-links button.active {
  color: #fff;
  border-color: rgba(153,92,255,.35);
  background: linear-gradient(100deg, rgba(111,53,255,.95), rgba(84,112,255,.30));
}

.cg-header-right {
  display: flex;
  align-items: center;
  gap: 9px;
}

.cg-header-icon {
  position: relative;
  width: 43px;
  height: 43px;
  border: 1px solid rgba(255,255,255,.075);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #fff;
  background: rgba(11,15,32,.72);
  cursor: pointer;
  transition: .2s ease;
}

.cg-header-icon:hover {
  border-color: rgba(162,111,255,.35);
  background: rgba(113,55,237,.14);
}

.cg-header-icon i {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #b56aff;
  box-shadow: 0 0 10px rgba(181,106,255,.7);
}

.cg-user {
  border: 0;
  padding: 0;
  display: flex;
  align-items: center;
  gap: 9px;
  color: #fff;
  background: transparent;
  cursor: pointer;
  text-align: left;
}

.cg-user > div:last-child {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.cg-user strong {
  font-size: 12px;
  font-weight: 800;
}

.cg-user small {
  max-width: 180px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #6e778e;
  font-size: 10px;
}

.cg-avatar {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  font-size: 14px;
  font-weight: 900;
  background: linear-gradient(135deg,#7036ff,#a64cff 58%,#40b2ff);
  box-shadow: 0 10px 25px rgba(105,52,255,.22);
}

.cg-search-box {
  width: min(700px, 100%);
  min-height: 47px;
  margin-bottom: 15px;
  padding: 0 14px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid rgba(147,91,255,.32);
  border-radius: 15px;
  background: rgba(10,14,30,.92);
  box-shadow: 0 12px 35px rgba(0,0,0,.18);
  animation: cgIn .2s ease both;
}

.cg-search-box > svg {
  color: #818ba3;
}

.cg-search-box input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  color: #fff;
  background: transparent;
  font-size: 13px;
}

.cg-search-box input::placeholder {
  color: #646e87;
}

.cg-search-box > button {
  width: 29px;
  height: 29px;
  border: 0;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #969fb2;
  background: rgba(255,255,255,.04);
  cursor: pointer;
}

.cg-notifications {
  position: absolute;
  z-index: 100;
  top: 76px;
  right: 24px;
  width: min(300px, calc(100vw - 36px));
  padding: 14px;
  box-sizing: border-box;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 17px;
  background: rgba(9,13,29,.96);
  box-shadow: 0 20px 55px rgba(0,0,0,.36);
  backdrop-filter: blur(20px);
}

.cg-notifications > div {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cg-notifications strong {
  font-size: 13px;
}

.cg-notifications button {
  width: 28px;
  height: 28px;
  border: 0;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #9099ad;
  background: rgba(255,255,255,.04);
  cursor: pointer;
}

.cg-notifications p {
  margin: 10px 0 0;
  color: #737d94;
  font-size: 11px;
}

.cg-hero {
  position: relative;
  min-height: 490px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 27px;
  background: #0a0d1a;
  box-shadow: 0 30px 90px rgba(0,0,0,.32);
  isolation: isolate;
  animation: cgReveal .5s ease both;
}

.cg-hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
  object-fit: cover;
  transform: scale(1.01);
}

.cg-hero-overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    linear-gradient(90deg, rgba(3,5,13,.99), rgba(3,5,13,.93) 18%, rgba(4,6,15,.70) 37%, rgba(5,7,16,.34) 59%, rgba(5,7,16,.10) 78%, rgba(4,6,15,.28)),
    linear-gradient(0deg, rgba(3,5,13,.94), rgba(3,5,13,.20) 60%);
}

.cg-hero-copy {
  position: absolute;
  left: 45px;
  bottom: 44px;
  width: min(555px, 56%);
}

.cg-hero-copy > span {
  display: inline-flex;
  padding: 7px 11px;
  border-radius: 7px;
  color: #fff;
  background: linear-gradient(90deg,#7137ff,#a84eff);
  box-shadow: 0 9px 23px rgba(116,55,255,.23);
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1px;
}

.cg-hero-copy h1 {
  margin: 16px 0 11px;
  max-width: 600px;
  font-size: clamp(42px,4.6vw,68px);
  line-height: .94;
  letter-spacing: -2px;
  text-shadow: 0 10px 38px rgba(0,0,0,.60);
}

.cg-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.cg-meta strong {
  color: #d1b7ff;
  font-size: 12px;
}

.cg-meta strong:nth-of-type(2) {
  padding: 4px 7px;
  border-radius: 6px;
  color: #f0f1f6;
  background: rgba(255,255,255,.10);
}

.cg-meta b {
  color: #687188;
  font-weight: 600;
}

.cg-hero-copy p {
  max-width: 495px;
  margin: 15px 0 20px;
  color: rgba(222,226,237,.82);
  font-size: 13px;
  line-height: 1.67;
}

.cg-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.cg-primary,
.cg-secondary {
  min-height: 45px;
  padding: 0 18px;
  border-radius: 13px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 900;
  transition: .2s ease;
}

.cg-primary {
  border: 0;
  color: #fff;
  background: linear-gradient(100deg,#6e35ff,#a54dff 62%,#4d82ff);
  box-shadow: 0 12px 31px rgba(106,50,255,.28);
}

.cg-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 16px 37px rgba(106,50,255,.36);
}

.cg-secondary {
  border: 1px solid rgba(255,255,255,.14);
  color: #fff;
  background: rgba(6,8,17,.56);
  backdrop-filter: blur(10px);
}

.cg-secondary:hover {
  transform: translateY(-2px);
  border-color: rgba(172,127,255,.36);
  background: rgba(116,57,239,.13);
}

.cg-hero-arrow {
  position: absolute;
  z-index: 5;
  top: 22px;
  width: 43px;
  height: 43px;
  border: 1px solid rgba(255,255,255,.11);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #fff;
  background: rgba(5,7,16,.52);
  backdrop-filter: blur(12px);
  cursor: pointer;
  transition: .2s ease;
}

.cg-hero-arrow.left {
  right: 74px;
}

.cg-hero-arrow.right {
  right: 20px;
}

.cg-hero-arrow:hover:not(:disabled) {
  transform: scale(1.04);
  border-color: rgba(173,128,255,.35);
  background: rgba(119,58,239,.25);
}

.cg-hero-arrow:disabled {
  opacity: .3;
  cursor: default;
}

.cg-dots {
  position: absolute;
  left: 50%;
  bottom: 17px;
  transform: translateX(-50%);
  display: flex;
  gap: 5px;
}

.cg-dots button {
  width: 7px;
  height: 7px;
  padding: 0;
  border: 0;
  border-radius: 99px;
  background: rgba(255,255,255,.27);
  cursor: pointer;
  transition: .2s ease;
}

.cg-dots button.active {
  width: 23px;
  background: linear-gradient(90deg,#843eff,#bd61ff);
  box-shadow: 0 0 12px rgba(177,84,255,.43);
}

.cg-empty-hero {
  min-height: 490px;
  border: 1px solid rgba(255,255,255,.055);
  border-radius: 27px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30px;
  box-sizing: border-box;
  text-align: center;
  background:
    radial-gradient(circle at 50% 38%, rgba(117,57,255,.13), transparent 28%),
    rgba(10,14,31,.78);
}

.cg-empty-icon {
  width: 68px;
  height: 68px;
  margin-bottom: 14px;
  border-radius: 19px;
  display: grid;
  place-items: center;
  color: #c9adff;
  background: rgba(115,55,255,.12);
  border: 1px solid rgba(156,99,255,.22);
}

.cg-empty-hero > span {
  color: #9e67ff;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.8px;
}

.cg-empty-hero h1 {
  margin: 10px 0 7px;
  font-size: 29px;
}

.cg-empty-hero p {
  max-width: 460px;
  margin: 0 0 20px;
  color: #7c859b;
  font-size: 12px;
  line-height: 1.65;
}

.cg-section {
  margin-top: 31px;
}

.cg-section-title {
  min-height: 28px;
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cg-section-title h2 {
  margin: 0;
  font-size: 20px;
  letter-spacing: -.35px;
}

.cg-section-title button {
  border: 0;
  display: inline-flex;
  align-items: center;
  gap: 2px;
  color: #b77cff;
  background: transparent;
  cursor: pointer;
  font-size: 12px;
  font-weight: 900;
}

.cg-section-title button:hover {
  color: #dfcaff;
}

.cg-empty-strip {
  min-height: 104px;
  border: 1px solid rgba(255,255,255,.05);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  color: #747e95;
  background: rgba(10,14,30,.58);
  font-size: 12px;
}

.cg-poster-grid {
  display: grid;
  grid-template-columns: repeat(6,minmax(0,1fr));
  gap: 15px;
}

.cg-poster-card {
  position: relative;
  min-width: 0;
}

.cg-poster {
  position: relative;
  width: 100%;
  aspect-ratio: .69;
  overflow: hidden;
  padding: 0;
  border: 1px solid rgba(255,255,255,.055);
  border-radius: 16px;
  display: block;
  color: #fff;
  background: #101425;
  cursor: pointer;
  box-shadow: 0 13px 31px rgba(0,0,0,.17);
  transition: .24s ease;
}

.cg-poster img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform .4s ease, filter .4s ease;
}

.cg-poster:hover {
  transform: translateY(-6px);
  border-color: rgba(165,119,255,.28);
  box-shadow: 0 18px 38px rgba(0,0,0,.27), 0 0 27px rgba(116,55,255,.09);
}

.cg-poster:hover img {
  transform: scale(1.055);
  filter: brightness(1.04);
}

.cg-placeholder {
  width: 100%;
  height: 100%;
  display: grid;
  place-items: center;
  color: #8b67c5;
  background: radial-gradient(circle at 50% 35%, rgba(125,66,255,.20), transparent 34%), #0c1020;
}

.cg-poster-gradient,
.cg-continue-gradient {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.cg-poster-gradient {
  background: linear-gradient(180deg, transparent 38%, rgba(3,5,13,.12) 52%, rgba(3,5,13,.88));
}

.cg-poster-play {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 41px;
  height: 41px;
  transform: translate(-50%,-50%) scale(.88);
  border-radius: 50%;
  display: grid;
  place-items: center;
  opacity: 0;
  background: linear-gradient(135deg,#7138ff,#ad51ff 60%,#4c88ff);
  box-shadow: 0 10px 28px rgba(102,50,255,.36);
  transition: .2s ease;
}

.cg-poster:hover .cg-poster-play {
  opacity: 1;
  transform: translate(-50%,-50%) scale(1);
}

.cg-save {
  position: absolute;
  z-index: 3;
  top: 9px;
  right: 9px;
  width: 34px;
  height: 34px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: #fff;
  background: rgba(4,6,14,.57);
  backdrop-filter: blur(10px);
  cursor: pointer;
  transition: .2s ease;
}

.cg-save:hover {
  transform: scale(1.08);
  border-color: rgba(179,137,255,.30);
  background: rgba(116,57,237,.22);
}

.cg-save.saved {
  color: #ebdcff;
  background: rgba(115,57,237,.72);
}

.cg-title {
  width: 100%;
  margin: 10px 2px 4px;
  padding: 0;
  overflow: hidden;
  border: 0;
  color: #f4f5fa;
  background: transparent;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
  cursor: pointer;
  font-size: 13px;
  font-weight: 800;
}

.cg-poster-card > p {
  margin: 0 2px;
  color: #7c859b;
  font-size: 10px;
}

.cg-continue-grid {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  gap: 15px;
}

.cg-large-grid {
  grid-template-columns: repeat(3,minmax(0,1fr));
}

.cg-continue-card {
  min-width: 0;
}

.cg-continue-image {
  position: relative;
  width: 100%;
  height: 157px;
  overflow: hidden;
  padding: 0;
  border: 1px solid rgba(255,255,255,.055);
  border-radius: 16px;
  display: block;
  color: #fff;
  background: #111527;
  cursor: pointer;
  box-shadow: 0 12px 28px rgba(0,0,0,.16);
  transition: .22s ease;
}

.cg-continue-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform .38s ease;
}

.cg-continue-image:hover {
  transform: translateY(-4px);
  border-color: rgba(157,112,255,.26);
}

.cg-continue-image:hover img {
  transform: scale(1.045);
}

.cg-continue-gradient {
  background: linear-gradient(180deg, transparent 28%, rgba(3,5,13,.10) 48%, rgba(3,5,13,.90));
}

.cg-continue-copy {
  position: absolute;
  left: 13px;
  right: 50px;
  bottom: 12px;
  display: flex;
  flex-direction: column;
  gap: 3px;
  text-align: left;
}

.cg-continue-copy strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13px;
}

.cg-continue-copy small {
  color: #c2c7d5;
  font-size: 10px;
}

.cg-continue-play {
  position: absolute;
  right: 11px;
  bottom: 11px;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg,#7138ff,#aa4fff);
  box-shadow: 0 9px 23px rgba(109,51,255,.30);
}

.cg-progress {
  height: 4px;
  margin-top: 8px;
  overflow: hidden;
  border-radius: 99px;
  background: rgba(255,255,255,.075);
}

.cg-progress span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg,#7338ff,#bd55ff 55%,#46b8ff);
}

.cg-page {
  padding: 10px 0 35px;
  animation: cgPage .3s ease both;
}

.cg-page-heading {
  margin-bottom: 20px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 15px;
}

.cg-page-heading > div > span {
  color: #a06cff;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.6px;
}

.cg-page-heading h2 {
  margin: 7px 0 5px;
  font-size: 30px;
  letter-spacing: -.8px;
}

.cg-page-heading p {
  margin: 0;
  color: #7c859c;
  font-size: 12px;
}

.cg-page-heading > strong {
  color: #757e96;
  font-size: 11px;
}

.cg-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 21px;
}

.cg-filter-row button {
  min-height: 37px;
  padding: 0 14px;
  border: 1px solid rgba(255,255,255,.075);
  border-radius: 11px;
  color: #9ea7bb;
  background: rgba(14,19,38,.72);
  cursor: pointer;
  transition: .2s ease;
}

.cg-filter-row button:hover {
  color: #fff;
  transform: translateY(-1px);
}

.cg-filter-row button.active {
  color: #fff;
  border-color: transparent;
  background: linear-gradient(90deg,#7137ff,#a650ff);
  box-shadow: 0 9px 24px rgba(113,55,255,.18);
}

.cg-discover-grid {
  grid-template-columns: repeat(6,minmax(0,1fr));
}

.cg-page-empty {
  min-height: 340px;
  border: 1px solid rgba(255,255,255,.055);
  border-radius: 22px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #7c869d;
  background:
    radial-gradient(circle at 50% 35%, rgba(119,57,255,.11), transparent 28%),
    rgba(10,14,31,.70);

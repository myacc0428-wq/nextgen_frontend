.cg-install-app-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 40px;
  padding: 0 15px;
  border: 1px solid rgba(126, 92, 255, 0.42);
  border-radius: 12px;
  color: #fff;
  background:
    linear-gradient(
      100deg,
      rgba(126, 54, 255, 0.95),
      rgba(77, 105, 255, 0.95),
      rgba(18, 200, 235, 0.95)
    );
  box-shadow:
    0 8px 26px rgba(102, 65, 255, 0.22),
    inset 0 1px 0 rgba(255,255,255,.12);
  font: inherit;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
  white-space: nowrap;
  transition:
    transform .2s ease,
    box-shadow .2s ease,
    filter .2s ease;
}

.cg-install-app-button:hover {
  transform: translateY(-1px);
  filter: brightness(1.06);
  box-shadow:
    0 11px 31px rgba(102, 65, 255, 0.30),
    inset 0 1px 0 rgba(255,255,255,.14);
}

.cg-install-app-button svg {
  flex: 0 0 auto;
}

.cg-apk-backdrop {
  position: fixed;
  inset: 0;
  z-index: 5000;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(2, 5, 13, 0.78);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  animation: cgApkFade .2s ease;
}

@keyframes cgApkFade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.cg-apk-modal {
  position: relative;
  width: min(680px, 94vw);
  display: flex;
  align-items: center;
  gap: 26px;
  padding: 30px;
  overflow: hidden;
  border: 1px solid rgba(127, 102, 255, 0.30);
  border-radius: 26px;
  background:
    radial-gradient(
      circle at 15% 18%,
      rgba(119, 57, 255, .19),
      transparent 29%
    ),
    radial-gradient(
      circle at 90% 84%,
      rgba(0, 205, 255, .12),
      transparent 28%
    ),
    linear-gradient(
      145deg,
      rgba(12, 23, 48, .98),
      rgba(5, 12, 27, .98)
    );
  box-shadow:
    0 35px 100px rgba(0,0,0,.50),
    0 0 50px rgba(91, 63, 255, .10),
    inset 0 1px 0 rgba(255,255,255,.06);
  color: #fff;
  animation: cgApkModal .25s ease;
}

@keyframes cgApkModal {
  from {
    opacity: 0;
    transform: translateY(10px) scale(.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.cg-apk-modal::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(
      120deg,
      transparent 20%,
      rgba(255,255,255,.025) 50%,
      transparent 80%
    );
}

.cg-apk-close {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.09);

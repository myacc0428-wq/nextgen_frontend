import { lazy, useEffect, useState } from "react";
import {
  createUserWithEmailAndPassword,
  onAuthStateChanged,
  sendPasswordResetEmail,
  signInWithEmailAndPassword,
  signOut,
  type User,
} from "firebase/auth";
import {
  collection,
  doc,
  onSnapshot,
  query,
  serverTimestamp,
  Timestamp,
  setDoc,
  updateDoc,
  where,
} from "firebase/firestore";
import {
  RefreshCw,
} from "lucide-react";
import { auth, db } from "./lib/firebase";
const CustomerAccessGate = lazy(() => import("./components/customer/CustomerAccessGate"));
import OpeningIntro from "./components/intro/OpeningIntro";
const Sidebar = lazy(() => import("./components/Sidebar"));
const DashboardHeader = lazy(() => import("./components/DashboardHeader"));
const StatsGrid = lazy(() => import("./components/StatsGrid"));
const ContentSection = lazy(() => import("./components/ContentSection"));
const SubscriberSection = lazy(() => import("./components/SubscriberSection"));
import PremiumLogin from "./components/PremiumLogin";

type Episode = {
  id: string;
  title?: string;
  seriesTitle?: string;
  genre?: string;
  episodeNumber?: number;
  contentType?: string;
  thumbnailUrl?: string;
  isPublished?: boolean;
  isAdminEntry?: boolean;
};

type Subscriber = {
  id: string;
  email?: string;
  accountStatus?: string;
  subscriptionStatus?: string;
  approvedBy?: string;
  approvedAt?: any;
  createdAt?: any;
  subscriptionRequestedAt?: any;
};

const GENRES = [
  "Action",
  "Adventure",
  "Comedy",
  "Drama",
  "Fantasy",
  "Horror",
  "Romance",
  "Sci-Fi",
  "Thriller",
  "Documentary",
];

function formatTimestamp(value: any) {
  if (!value) return "—";

  try {
    if (typeof value.toDate === "function") {
      return value.toDate().toLocaleString();
    }

    return new Date(value).toLocaleString();
  } catch {
    return "—";
  }
}

function App() {
  const [user, setUser] = useState<User | null>(null);
  const [checkingAuth, setCheckingAuth] = useState(true);
  const [showIntro, setShowIntro] = useState(() =>
    typeof window !== "undefined" &&
    sessionStorage.getItem("cinegen_intro_seen") !== "1"
  );
  const [adminAllowed, setAdminAllowed] = useState(false);
  const [episodes, setEpisodes] = useState<Episode[]>([]);
  const [subscribers, setSubscribers] = useState<Subscriber[]>([]);
  const [loginError, setLoginError] = useState("");
  const [loading, setLoading] = useState(false);
  const [subscriberActionId, setSubscriberActionId] = useState<string | null>(
    null
  );
  const [message, setMessage] = useState("");
  const [activeSection, setActiveSection] = useState<"dashboard" | "content" | "subscribers">("dashboard");

  const navigateTo = (section: "dashboard" | "content" | "subscribers") => {
    setActiveSection(section);

    const targetId =
      section === "dashboard"
        ? "dashboard-section"
        : section === "content"
          ? "content-section"
          : "subscribers-section";

    document.getElementById(targetId)?.scrollIntoView({
      behavior: "smooth",
      block: "start",
    });
  };

  useEffect(() => {
    const unsubscribe = onAuthStateChanged(auth, async (currentUser) => {
      setUser(currentUser);

      if (!currentUser) {
        setAdminAllowed(false);
        setCheckingAuth(false);
        return;
      }

      try {
        const isAdmin =
          currentUser.uid === "pxxnt9iRPkVCabOdgjkAGuuTN692";

        console.log("CINEGEN ADMIN CHECK:", {
          uid: currentUser.uid,
          email: currentUser.email,
          isAdmin,
        });

        if (isAdmin) {
          setAdminAllowed(true);
          setLoginError("");
        } else {
          setAdminAllowed(false);
          setLoginError("");
        }
      } catch (error) {
        console.error(error);
        setAdminAllowed(false);
        setLoginError("Unable to verify Admin access.");
      }

      setCheckingAuth(false);
    });

    return unsubscribe;
  }, []);

  useEffect(() => {
    if (!adminAllowed) {
      setEpisodes([]);
      return;
    }

    const episodesQuery = query(
      collection(db, "episodes"),
      where("isAdminEntry", "==", true)
    );

    const unsubscribe = onSnapshot(
      episodesQuery,
      (snapshot) => {
        const data = snapshot.docs.map((item) => ({
          id: item.id,
          ...(item.data() as Omit<Episode, "id">),
        }));

        setEpisodes(data);
      },
      (error) => {
        console.error(error);
        setMessage("Unable to load Admin content.");
      }
    );

    return unsubscribe;
  }, [adminAllowed]);

  useEffect(() => {
    if (!adminAllowed) {
      setSubscribers([]);
      return;
    }

    const unsubscribe = onSnapshot(
      collection(db, "users"),
      (snapshot) => {
        const data = snapshot.docs.map((item) => ({
          id: item.id,
          ...(item.data() as Omit<Subscriber, "id">),
        }));

        setSubscribers(
          data.sort((a, b) => {
            const getTime = (value: any) => {
              if (!value) return 0;
              if (typeof value.toMillis === "function") return value.toMillis();
              if (typeof value.toDate === "function") return value.toDate().getTime();

              const time = new Date(value).getTime();
              return Number.isFinite(time) ? time : 0;
            };

            const aTime = getTime(a.subscriptionRequestedAt || a.createdAt);
            const bTime = getTime(b.subscriptionRequestedAt || b.createdAt);

            return bTime - aTime;
          })
        );
      },
      (error) => {
        console.error(error);
        setMessage("Unable to load subscribers.");
      }
    );

    return unsubscribe;
  }, [adminAllowed]);

  const handleLogin = async (loginEmail: string, loginPassword: string) => {
    setLoginError("");
    setLoading(true);
    try {
      await signInWithEmailAndPassword(
        auth,
        loginEmail.trim(),
        loginPassword,
      );
    } catch (error: any) {
      console.error(error);
      setLoginError(
        error?.code === "auth/invalid-credential"
          ? "Invalid email or password."
          : "Login failed. Please try again."
      );
    } finally {
      setLoading(false);
    }
  };

  const handleForgotPassword = async (resetEmail: string) => {
    const normalizedEmail = resetEmail.trim().toLowerCase();

    if (!normalizedEmail) {
      return {
        success: false,
        message: "Please enter your email address.",
      };
    }

    try {
      await sendPasswordResetEmail(
        auth,
        normalizedEmail,
      );

      return {
        success: true,
        message:
          "Reset request sent. Check your inbox, Spam, and Promotions folders.",
      };
    } catch (error: any) {
      console.error("PASSWORD RESET ERROR:", error);

      switch (error?.code) {
        case "auth/invalid-email":
          return {
            success: false,
            message: "Please enter a valid email address.",
          };

        case "auth/user-not-found":
          return {
            success: false,
            message:
              "No CineGen account was found with that email address.",
          };

        case "auth/too-many-requests":
          return {
            success: false,
            message:
              "Too many reset attempts. Please wait a moment and try again.",
          };

        case "auth/network-request-failed":
          return {
            success: false,
            message:
              "Network error. Please check your internet connection and try again.",
          };

        case "auth/operation-not-allowed":
        return {
          success: false,
          message:
            "Password reset is not enabled for this Firebase project.",
        };

      case "auth/internal-error":
        return {
          success: false,
          message:
            "Firebase returned an internal error while sending the reset email.",
        };

      default:
        return {
          success: false,
          message:
            `Password reset failed (${error?.code || "unknown-error"}). Please try again.`,
        };
      }
    }
  };

  const handleCreateAccount = async (
    newEmail: string,
    newPassword: string,
  ) => {
    const normalizedEmail = newEmail.trim();

    if (!normalizedEmail || !newPassword) {
      return {
        success: false,
        message: "Email and password are required.",
      };
    }

    setLoading(true);

    try {
      const credential = await createUserWithEmailAndPassword(
        auth,
        normalizedEmail,
        newPassword,
      );

      await setDoc(doc(db, "users", credential.user.uid), {
        email: normalizedEmail,
        accountStatus: "pending",
        subscriptionStatus: "pending",
        createdAt: serverTimestamp(),
        subscriptionRequestedAt: serverTimestamp(),
      });

      await signOut(auth);

      return {
        success: true,
        message:
          "Account created successfully. Your request is now pending Admin approval.",
      };
    } catch (error: any) {
      console.error(error);

      if (error?.code === "auth/email-already-in-use") {
        return {
          success: false,
          message: "An account with this email already exists.",
        };
      }

      if (error?.code === "auth/invalid-email") {
        return {
          success: false,
          message: "Please enter a valid email address.",
        };
      }

      if (error?.code === "auth/weak-password") {
        return {
          success: false,
          message: "Password must be at least 6 characters.",
        };
      }

      return {
        success: false,
        message: "Unable to create the account. Please try again.",
      };
    } finally {
      setLoading(false);
    }
  };

  const handleLogout = async () => {
    await signOut(auth);
    setMessage("");
  };

  const handleGenreChange = async (episodeId: string, genre: string) => {
    try {
      await updateDoc(doc(db, "episodes", episodeId), {
        genre,
      });

      setMessage(`Genre updated to ${genre}.`);
      setTimeout(() => setMessage(""), 2500);
    } catch (error) {
      console.error(error);
      setMessage("Failed to update genre.");
    }
  };

  const handleSubscriberDecision = async (
    subscriberId: string,
    decision: "approve" | "reject"
  ) => {
    setSubscriberActionId(subscriberId);
    setMessage("");

    try {
      if (decision === "approve") {
        const subscriptionStartedAt = new Date();
        const originalDay = subscriptionStartedAt.getDate();

        const subscriptionExpiresDate = new Date(subscriptionStartedAt);
        subscriptionExpiresDate.setDate(1);
        subscriptionExpiresDate.setMonth(
          subscriptionExpiresDate.getMonth() + 1
        );

        const lastDayOfTargetMonth = new Date(
          subscriptionExpiresDate.getFullYear(),
          subscriptionExpiresDate.getMonth() + 1,
          0
        ).getDate();

        subscriptionExpiresDate.setDate(
          Math.min(originalDay, lastDayOfTargetMonth)
        );

        await updateDoc(doc(db, "users", subscriberId), {
          accountStatus: "active",
          subscriptionStatus: "active",
          approvedAt: serverTimestamp(),
          approvedBy: user?.email || "Admin",
          subscriptionStartedAt: Timestamp.fromDate(subscriptionStartedAt),
          subscriptionExpiresAt: Timestamp.fromDate(subscriptionExpiresDate),
        });

        setMessage("Subscriber approved successfully.");
      } else {
        await updateDoc(doc(db, "users", subscriberId), {
          accountStatus: "rejected",
          subscriptionStatus: "rejected",
        });

        setMessage("Subscriber rejected.");
      }

      setTimeout(() => setMessage(""), 3000);
    } catch (error) {
      console.error(error);
      setMessage(
        decision === "approve"
          ? "Failed to approve subscriber."
          : "Failed to reject subscriber."
      );
    } finally {
      setSubscriberActionId(null);
    }
  };

  const pendingSubscribers = subscribers.filter(
    (subscriber) =>
      subscriber.accountStatus === "pending" ||
      subscriber.subscriptionStatus === "pending"
  );

  const activeSubscribers = subscribers.filter(
    (subscriber) =>
      subscriber.accountStatus === "active" &&
      subscriber.subscriptionStatus === "active"
  );

  if (showIntro) {
    return (
      <OpeningIntro
        onComplete={() => {
          sessionStorage.setItem("cinegen_intro_seen", "1");
          setShowIntro(false);
        }}
      />
    );
  }

  if (checkingAuth) {
    return (
      <div className="loading-screen">
        <div className="loading-card">
          <RefreshCw size={28} className="spin" />
          <span>Checking Admin access...</span>
        </div>
      </div>
    );
  }

  if (!user) {
    return (
      <PremiumLogin
        loginError={loginError}
        loading={loading}
        onSubmit={handleLogin}
        onForgotPassword={handleForgotPassword}
        onCreateAccount={handleCreateAccount}
      />
    );
  }

  if (user && !adminAllowed) {
    return <CustomerAccessGate user={user} />;
  }

  return (
    <div className="app-shell">
      <Sidebar
  activeSection={activeSection}
  onNavigate={navigateTo}
  pendingCount={pendingSubscribers.length}
  userEmail={user?.email}
  onLogout={handleLogout}
/>

      <main className="dashboard">
        <DashboardHeader userEmail={user?.email} />

        {message && <div className="success-box">{message}</div>}

        <StatsGrid
  totalContent={episodes.length}
  published={episodes.filter((episode) => episode.isPublished).length}
  pendingSubscribers={pendingSubscribers.length}
  activeSubscribers={activeSubscribers.length}
/>

        <ContentSection
  episodes={episodes}
  genres={GENRES}
  onGenreChange={handleGenreChange}
/>

        <SubscriberSection
  subscribers={subscribers}
  pendingCount={pendingSubscribers.length}
  actionId={subscriberActionId}
  onDecision={handleSubscriberDecision}
  formatTimestamp={formatTimestamp}
/>
      </main>
    </div>
  );
}

export default App;





































